# Copy to .env.local and fill in.

# Postgres connection string. Leave unset in local dev to use the built-in PGlite database in data/pglite.
# DATABASE_URL=postgres://user:password@host:5432/stadium

# Better Auth: a random 32+ character secret (e.g. `openssl rand -base64 32`) and the site's public URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Show the "Test tools" bar (Test sign up + demo account switcher) in a production build.
# It's always on in `npm run dev`.
# STADIUM_TEST_TOOLS=1

# Stripe Connect (seller identity + payouts) — not wired up yet.
# STRIPE_SECRET_KEY=
